{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make ui-check)",
      "Bash(make format)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run pre-commit run:*)",
      "Bash(pnpm -C ui run:*)",
      "Bash(pnpm -C ui exec biome:*)",
      "Bash(pnpm -C ui exec vitest:*)"
    ]
  }
}
